namespace HomePageConfigTests
    @suite("HomePageConfig tests")
    class HomePageConfigTestSuite extends Rooibos.BaseTestSuite
        '==============================================
        @describe("getRowBatch()")
        '==============================================

        @it("returns first batch with up to ROWS_PER_PAGE rows")
        function test_getRowBatch_firstBatch() as object
            ' bs:disable-next-line
            result = HomePageConfig.getRowBatch(0)

            m.assertTrue(result.rows.count() > 0, `First batch should have rows`)
            m.assertTrue(result.rows.count() <= HomePageConfig.ROWS_PER_PAGE, `First batch should not exceed ROWS_PER_PAGE`)

            return invalid
        end function

        @it("returns hasMore true when more rows exist")
        function test_getRowBatch_hasMoreTrue() as object
            ' bs:disable-next-line
            allRows = HomePageConfig.getRows()
            if allRows.count() <= HomePageConfig.ROWS_PER_PAGE then return invalid

            ' bs:disable-next-line
            result = HomePageConfig.getRowBatch(0)

            m.assertTrue(result.hasMore, `hasMore should be true when total rows exceed ROWS_PER_PAGE`)

            return invalid
        end function

        @it("returns hasMore false for last batch")
        function test_getRowBatch_hasMoreFalse() as object
            ' bs:disable-next-line
            allRows = HomePageConfig.getRows()
            totalRows = allRows.count()

            lastBatchStart = totalRows - (totalRows mod HomePageConfig.ROWS_PER_PAGE)
            if lastBatchStart = totalRows then lastBatchStart = totalRows - HomePageConfig.ROWS_PER_PAGE

            ' bs:disable-next-line
            result = HomePageConfig.getRowBatch(lastBatchStart)

            m.assertFalse(result.hasMore, `hasMore should be false for last batch`)

            return invalid
        end function

        @it("returns empty batch when startIndex exceeds total rows")
        function test_getRowBatch_startIndexBeyondEnd() as object
            ' bs:disable-next-line
            allRows = HomePageConfig.getRows()
            totalRows = allRows.count()

            ' bs:disable-next-line
            result = HomePageConfig.getRowBatch(totalRows + 10)

            m.assertEqual(result.rows.count(), 0, `Should return empty batch when startIndex exceeds total rows`)
            m.assertFalse(result.hasMore, `hasMore should be false when no rows returned`)

            return invalid
        end function

        @it("returns rows with correct structure")
        function test_getRowBatch_rowStructure() as object
            ' bs:disable-next-line
            result = HomePageConfig.getRowBatch(0)

            firstRow = result.rows[0]
            m.assertNotInvalid(firstRow.title, `Row should have title`)
            m.assertNotInvalid(firstRow.action, `Row should have action`)

            return invalid
        end function

        @it("returns rows with params when row has params")
        function test_getRowBatch_rowWithParams() as object
            ' bs:disable-next-line
            allRows = HomePageConfig.getRows()

            rowWithParams = invalid
            for each row in allRows
                if row.params <> invalid
                    rowWithParams = row
                    exit for
                end if
            end for

            if rowWithParams = invalid then return invalid

            m.assertNotInvalid(rowWithParams.params, `Row with params should have params object`)

            return invalid
        end function

        @it("respects ROWS_PER_PAGE constant for all batches")
        function test_getRowBatch_respectsRowsPerPage() as object
            ' bs:disable-next-line
            allRows = HomePageConfig.getRows()
            totalRows = allRows.count()

            for startIndex = 0 to totalRows - 1 step HomePageConfig.ROWS_PER_PAGE
                ' bs:disable-next-line
                result = HomePageConfig.getRowBatch(startIndex)
                m.assertTrue(result.rows.count() <= HomePageConfig.ROWS_PER_PAGE, `Batch at ${startIndex} should not exceed ROWS_PER_PAGE`)
            end for

            return invalid
        end function

        @it("returns consecutive batches that cover all rows")
        function test_getRowBatch_coversAllRows() as object
            ' bs:disable-next-line
            allRows = HomePageConfig.getRows()
            totalRows = allRows.count()

            collectedRows = 0
            startIndex = 0
            hasMore = true

            while hasMore
                ' bs:disable-next-line
                result = HomePageConfig.getRowBatch(startIndex)
                collectedRows += result.rows.count()
                hasMore = result.hasMore
                startIndex += HomePageConfig.ROWS_PER_PAGE
            end while

            m.assertEqual(collectedRows, totalRows, `All batches combined should equal total rows`)

            return invalid
        end function

        '==============================================
        @describe("getRows()")
        '==============================================

        @it("returns non-empty array")
        function test_getRows_returnsArray() as object
            ' bs:disable-next-line
            result = HomePageConfig.getRows()

            m.assertTrue(result.count() > 0, `Should return non-empty array of rows`)

            return invalid
        end function

        @it("all rows have required fields")
        function test_getRows_allRowsHaveRequiredFields() as object
            ' bs:disable-next-line
            allRows = HomePageConfig.getRows()

            for each row in allRows
                m.assertNotInvalid(row.title, `Every row should have a title`)
                m.assertNotInvalid(row.action, `Every row should have an action`)
            end for

            return invalid
        end function
    end class
end namespace
