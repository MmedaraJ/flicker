namespace HomePageConfig
    const PAGE_SIZE = 10
    const MAX_PER_ROW = 50
    const ROWS_PER_PAGE = 10

    function getRowBatch(startIndex as integer) as object
        allRows = getRows()
        allRowsCount = allRows.count()

        endIndex = startIndex + ROWS_PER_PAGE - 1
        if endIndex >= allRowsCount then endIndex = allRowsCount - 1

        batch = []
        for i = startIndex to endIndex
            batch.push(allRows[i])
        end for

        return {
            rows: batch,
            hasMore: endIndex < allRowsCount - 1
        }
    end function

