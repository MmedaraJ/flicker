namespace HomePageConfig
    const PAGE_SIZE = 10
    const MAX_PER_ROW = 50

    function getRows() as object
        return [
            { title: "Recent Photos", action: "flickr.recent" },
            { title: "Nature", action: "flickr.search", params: { tags: "nature" } },
            { title: "Architecture", action: "flickr.search", params: { tags: "architecture" } },
            { title: "Animals", action: "flickr.search", params: { tags: "animals" } }
        ]
    end function
end namespace
