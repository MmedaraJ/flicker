<?xml version="1.0" encoding="UTF-8"?>
<component name="gridScreen" extends="Group" initialFocus="RowList">
    <script type="text/brightscript" uri="pkg:/source/config/homePageConfig.bs" />
    <script type="text/brightscript" uri="pkg:/components/gridScreen/gridScreenConfig.bs" />
    <script type="text/brightscript" uri="pkg:/source/utils/common.bs" />

	<interface>
        <field id="content" type="node" alias="RowList.content" onChange="onContentChange" />
        <field id="rowItemSelected" type="intarray" alwaysnotify="true" alias="RowList.rowItemSelected" />
        <field id="rowItemFocused" type="intarray" alwaysnotify="true" alias="RowList.rowItemFocused" />
        <field id="jumpToRowItem" type="intarray" alias="RowList.jumpToRowItem" />
    </interface>
    
    <children>
        <RowList
            itemComponentName="rowListItemComponent"
            id="rowList"
            translation="[50,50]"
            numRows="4"
            rowitemSize="[[150,150]]"
            rowItemSpacing="[[20,0]]"
            itemSize="[1150,240]"
            rowLabelOffset="[[50,20]]"
            focusXOffset="[50]"
            showRowLabel="[true]"
            rowLabelFont="font:MediumBoldSystemFont"
            rowFocusAnimationStyle="floatingFocus"
            vertFocusAnimationStyle="fixedFocus"
        />

        <Group id="loadingIndicator" translation="[640,650]" visible="false">
            <Rectangle width="200" height="40" color="0xFFFFFFFF" translation="[-100,0]" />
            <Label 
                text="Loading..." 
                width="200" 
                height="40" 
                horizAlign="center" 
                vertAlign="center" 
                translation="[-100,0]" 
                color="0x000000FF" 
                font="font:MediumBoldSystemFont" 
            />
        </Group>
    </children>
</component>
